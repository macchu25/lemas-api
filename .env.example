MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/lemas_db?retryWrites=true&w=majority
PORT=8080
JWT_SECRET=lemas-secret-key-super-secure-token-2026
HF_TOKEN=hf_your_token
HF_ART_QR_SPACE_URL=https://your-account-lemas-art-qr.hf.space
ART_QR_MAX_ATTEMPTS=2

# Upstream AI Provider (xKiro Gateway & Rotating API Keys)
UPSTREAM_BASE_URL=https://api.xkiro.com/v1
# Danh sách API Keys xoay vòng (cách nhau bằng dấu phẩy)
UPSTREAM_API_KEYS=sk-xt-your-key-1,sk-xt-your-key-2,sk-xt-your-key-3

# xKiro Vision AI Analyzer (apigiare.vn / OpenAI gpt-4o)
XKIRO_BASE_URL=https://apigiare.vn/v1
XKIRO_API_KEY=sk-your-vision-api-key
XKIRO_VISION_MODEL=gpt-4o

# MachGen Image & Art QR Generator (Pollinations, Replicate hoặc OpenAI-compatible API)
# Để trống URL & KEY sẽ tự động dùng Pollinations AI miễn phí
MACHGEN_API_URL=
MACHGEN_API_KEY=
MACHGEN_MODEL=flux

# Email Verification (SMTP - Gmail App Password / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=Lemas.AI <your-email@gmail.com>
